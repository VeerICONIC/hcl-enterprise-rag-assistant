# Copy to .env (git-ignored) and adjust. Names only: never put AWS keys here.
# Credentials come from the AWS default chain (e.g. `aws sso login --profile <name>`).

AWS_REGION=us-east-1
# Optional named profile (SSO or shared credentials file). Leave blank for the default chain.
AWS_PROFILE=

BEDROCK_EMBED_MODEL_ID=amazon.titan-embed-text-v2:0
# Titan V2 supports 256, 512 or 1024. Fixed once indexed; changing it requires re-indexing.
BEDROCK_EMBED_DIM=1024
# Some regions/accounts need an inference profile, e.g. us.amazon.nova-lite-v1:0
BEDROCK_LLM_MODEL_ID=amazon.nova-lite-v1:0

CHROMA_PATH=data/chroma
CHROMA_COLLECTION=enterprise_docs

# Ingestion. Chunk size/overlap are in characters (heading prefix excluded from the size).
CHUNK_SIZE=1000
CHUNK_OVERLAP=150
MAX_UPLOAD_SIZE_MB=25
SUPPORTED_FILE_TYPES=pdf,html,htm,md,markdown,txt
# Concurrent Titan requests per batch (Titan has no native batch API).
EMBEDDING_BATCH_SIZE=8

RETRIEVAL_TOP_N=20
MIN_RELEVANCE=0.30
# Reciprocal Rank Fusion constant
RRF_K=60

# Generation (Nova Lite)
LLM_MAX_TOKENS=800
LLM_TEMPERATURE=0.0
MAX_CONTEXT_CHUNKS=6

# Where evaluation results are written/read
REPORTS_DIR=reports

API_BASE_URL=http://localhost:8000
# Optional shared secret for a hosted backend. When set on the backend, every route except /health requires the
# header X-API-Key; set the same value as API_KEY in the frontend (Streamlit secrets). Leave empty for local use.
API_KEY=
