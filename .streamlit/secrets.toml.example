# Template for Streamlit Community Cloud: App settings -> Secrets (paste the values there).
# For local use you do NOT need this file: copy it to .streamlit/secrets.toml (git-ignored) only if you want to test it.

# Public https URL of the deployed FastAPI backend, WITHOUT a trailing path (no /health, no /docs).
API_BASE_URL = "https://hcl-docqa-api.onrender.com"

# Same value as the backend's API_KEY environment variable (Render generates it). Omit this line if the backend has none.
API_KEY = "paste-the-backend-api-key-here"

# Optional: seconds to wait for the backend (raise it if a sleeping free-tier backend needs time to wake up).
# API_TIMEOUT_SECONDS = 60
